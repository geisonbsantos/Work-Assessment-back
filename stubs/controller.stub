<?php

namespace App\Http\Controllers\Api;

use App\Http\Requests\StoreUpdate{{ class }}FormRequest;
use App\Services\{{ class }}Service;
use Illuminate\Http\JsonResponse;

class {{ class }}Controller extends CrudController
{
    public function __construct(private {{ class }}Service $service)
    {
        parent::__construct($service);
    }

    protected function beforeStore(StoreUpdate{{ class }}FormRequest $request): JsonResponse
    {
        $request->validated();
        return $this->store($request);
    }

    protected function beforeUpdate(StoreUpdate{{ class }}FormRequest $request, int $id): JsonResponse
    {
        $request->validated();
        return $this->update($request, $id);
    }

    public function restore(int $id): JsonResponse
    {
        $this->service->restore($id);
        return response()->json(['message' => 'Registro restaurado com sucesso.'], 200);
    }
}
